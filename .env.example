APP_NAME=RANIAG
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Ilocano/Itawis packs deferred until translators are available.
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=raniag
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SMS_PROVIDER=PhilSMS
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

RANIAG_NAME=RANIAG
RANIAG_ORGANIZATION="MDRRMO Pamplona"
RANIAG_TAGLINE="Incident Reporting & Dispatch"
RANIAG_SLA_TARGET_HOURS=48
RANIAG_TWO_FACTOR_ENABLED=true
RANIAG_TWO_FACTOR_OTP_TTL=10
# -1 = permanent trust (default), 0 = force OTP every login, N = bounded days
RANIAG_TWO_FACTOR_TRUSTED_DAYS=-1
RANIAG_RETENTION_SOFT_DELETE_DAYS=90
RANIAG_RETENTION_CLOSED_PII_DAYS=365
RANIAG_TRACKING_PREFIX=RAN

RANIAG_MAP_LAT=18.472
RANIAG_MAP_LNG=121.325
RANIAG_MAP_ZOOM=13

# Public Mapbox token (pk.*) for hazard map tiles + route to nearest evac center.
# Restrict by URL in the Mapbox account dashboard. Never commit the real token.
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/streets-v12
MAPBOX_DIRECTIONS_PROFILE=walking

RANIAG_MUNICIPALITY=Pamplona
RANIAG_PROVINCE=Cagayan
RANIAG_COUNTRY=Philippines

RANIAG_PAMPLONA_BOUNDARY_PATH=geo/pamplona_boundary.geojson
RANIAG_PAMPLONA_BARANGAYS_PATH=geo/pamplona_barangays.geojson

RANIAG_EVIDENCE_MAX_FILES=5
RANIAG_EVIDENCE_MAX_SIZE_KB=5120

RANIAG_GEO_TIMEOUT_MS=15000
RANIAG_GEO_MAX_AGE_MS=0
RANIAG_GPS_MAX_CAPTURES=5
